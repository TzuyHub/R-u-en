local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

-- Tốc độ bay (có thể điều chỉnh lớn/nhỏ tùy ý)
local FLY_SPEED = 250 

-- Hàm kiểm tra vật phẩm
local function checkItem(itemName)
    if LocalPlayer.Backpack:FindFirstChild(itemName) then
        return true
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(itemName) then
        return true
    end
    return false
end

-- Hàm bay mượt bằng Lerp (Không bị giật khung hình)
local function smoothFlyTo(targetCFrame)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    -- Tắt trọng lực tạm thời bằng cách đưa nhân vật về trạng thái PlatformStand hoặc vô hiệu hóa điều khiển hướng
    if humanoid then
        humanoid.PlatformStand = true
    end

    local startPos = rootPart.Position
    local endPos = targetCFrame.Position
    local distance = (startPos - endPos).Magnitude
    local totalTime = distance / FLY_SPEED
    local elapsed = 0

    while elapsed < totalTime do
        if checkItem("Dark Coat") or checkItem("Fist of Darkness") then break end
        if not character or not character.Parent or not rootPart.Parent then break end

        local dt = RunService.RenderStepped:Wait()
        elapsed = elapsed + dt
        local alpha = math.clamp(elapsed / totalTime, 0, 1)
        
        -- Tính toán vị trí mượt mà bằng Lerp
        rootPart.CFrame = CFrame.new(startPos:Lerp(endPos, alpha)) * (targetCFrame - targetCFrame.Position)
        
        -- Khóa vận tốc để không bị rơi rớt hay khựng physics
        rootPart.Velocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end

    -- Bật lại trạng thái bình thường cho nhân vật
    if humanoid then
        humanoid.PlatformStand = false
    end
    rootPart.CFrame = targetCFrame
end

-- Hàm Hop Server
local function hopServer()
    pcall(function()
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
        for _, server in ipairs(servers.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                break
            end
        end
    end)
end

