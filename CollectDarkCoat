-- ==========================================================
-- SCRIPT AUTO FIST OF DARKNESS & BLACKBEARD CAPE + TWEEN
-- ==========================================================

if getgenv().AutoFarmDarkCoatRunning then
    return
end
getgenv().AutoFarmDarkCoatRunning = true

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TweenService = game:GetService("TweenService")
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")

-- Tốc độ bay/tween (điều chỉnh tăng giảm tùy ý, mặc định 300 là khá an toàn)
local TWEEN_SPEED = 300 

-- Hàm kiểm tra vật phẩm
local function checkItem(itemName)
    if LocalPlayer.Backpack:FindFirstChild(itemName) then
        return true
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(itemName) then
        return true
    end
    return false
end

-- Hàm Tween (di chuyển mượt đến vị trí chỉ định)
local function tweenTo(targetCFrame)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local distance = (rootPart.Position - targetCFrame.Position).Magnitude
    local timeToTravel = distance / TWEEN_SPEED
    
    local tweenInfo = TweenInfo.new(timeToTravel, Enum.EasingStyle.Linear)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = targetCFrame})
    
    getgenv().CurrentTween = tween
    tween:Play()
    
    local completed = false
    local connection
    connection = tween.Completed:Connect(function()
        completed = true
        if connection then connection:Disconnect() end
    end)
    
    -- Đợi cho đến khi tween chạy xong hoặc bị ngắt
    while not completed and character and character.Parent do
        if checkItem("Dark Coat") or checkItem("Fist of Darkness") then
            tween:Cancel()
            if connection then connection:Disconnect() end
            break
        end
        task.wait(0.1)
    end
end

-- Hàm Hop Server
local function hopServer()
    local success, err = pcall(function()
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
        for _, server in ipairs(servers.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                break
            end
        end
    end)
    if not success then
        warn("Lỗi khi hop server, đang thử lại...")
        task.wait(2)
        hopServer()
    end
end

-- Vòng lặp chính
