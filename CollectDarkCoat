local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local TeleportService = game:GetService("TeleportService")
local HttpService = game:GetService("HttpService")
local RunService = game:GetService("RunService")

-- Tốc độ bay được đặt chính xác là 236
local FLY_SPEED = 236 

-- Hàm kiểm tra vật phẩm
local function checkItem(itemName)
    if LocalPlayer.Backpack:FindFirstChild(itemName) then
        return true
    end
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(itemName) then
        return true
    end
    return false
end

-- Hàm bay mượt bằng Lerp với tốc độ 236
local function smoothFlyTo(targetCFrame)
    local character = LocalPlayer.Character
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    
    local rootPart = character.HumanoidRootPart
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    
    if humanoid then
        humanoid.PlatformStand = true
    end

    local startPos = rootPart.Position
    local endPos = targetCFrame.Position
    local distance = (startPos - endPos).Magnitude
    local totalTime = distance / FLY_SPEED
    local elapsed = 0

    while elapsed < totalTime do
        if checkItem("Dark Coat") or checkItem("Fist of Darkness") then break end
        if not character or not character.Parent or not rootPart.Parent then break end

        local dt = RunService.RenderStepped:Wait()
        elapsed = elapsed + dt
        local alpha = math.clamp(elapsed / totalTime, 0, 1)
        
        rootPart.CFrame = CFrame.new(startPos:Lerp(endPos, alpha)) * (targetCFrame - targetCFrame.Position)
        rootPart.Velocity = Vector3.new(0, 0, 0)
        rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    end

    if humanoid then
        humanoid.PlatformStand = false
    end
    rootPart.CFrame = targetCFrame
end

-- Hàm quét và sắp xếp rương từ gần đến xa
local function getSortedChests()
    local chests = {}
    local rootPart = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return chests end

    for _, v in pairs(workspace:GetDescendants()) do
        if v.Name:lower():find("chest") and v:IsA("BasePart") then
            table.insert(chests, v)
        end
    end

    -- Sắp xếp rương: Rương gần nhất đứng đầu danh sách
    table.sort(chests, function(a, b)
        local distA = (a.Position - rootPart.Position).Magnitude
        local distB = (b.Position - rootPart.Position).Magnitude
        return distA < distB
    end)

    return chests
end

-- Hàm Hop Server
local function hopServer()
    pcall(function()
        local servers = HttpService:JSONDecode(game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100"))
        for _, server in ipairs(servers.data) do
            if server.playing < server.maxPlayers and server.id ~= game.JobId then
                TeleportService:TeleportToPlaceInstance(game.PlaceId, server.id, LocalPlayer)
                break
            end
        end
    end)
end

-- Vòng lặp chính
task.spawn(function()
    while true do
        if checkItem("Dark Coat") then
            print("Đã có Áo choàng râu đen! Dừng script.")
            break
        end

        print("Bắt đầu quét và nhặt rương từ gần đến xa với tốc độ 236...")
        local chestCount = 0
        local startTime = tick()
        local fourHours = 4 * 60 * 60

        local chestsList = getSortedChests()
        
        for _, v in ipairs(chestsList) do
            if checkItem("Dark Coat") or checkItem("Fist of Darkness") then break end
            
            if (tick() - startTime) >= fourHours then
                print("Đã chạy đủ 4 tiếng, tiến hành hop server...")
                hopServer()
                task.wait(10)
                break
            end

            if v and v.Parent and v:IsA("BasePart") then
                if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    smoothFlyTo(v.CFrame)
                    task.wait(0.25)
                    chestCount = chestCount + 1
                    print("Đã nhặt rương thứ: " .. chestCount)
                    
                    if chestCount >= 36 then
                        break
                    end
                end
            end
        end

        if checkItem("Fist of Darkness") then
            print("Đã có Fist of Darkness! Bay đến bệ thờ triệu hồi Râu Đen...")
            
            if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                smoothFlyTo(CFrame.new(3775, 20, -3499))
                task.wait(2)
            end
            
            repeat
                task.wait(2)
                print("Đang đánh Râu Đen săn Áo choàng...")
            until not workspace.Enemies:FindFirstChild("Darkbeard") or checkItem("Dark Coat")
            
        else
            print("Không ra Fist of Darkness, tiến hành hop server...")
            hopServer()
            task.wait(10)
        end
        
        task.wait(1)
    end
end)
