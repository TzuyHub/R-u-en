import time
import sys

def real_flex_loading(text):
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(0.02)
    print()

class UltimateLuckBuffer:
    def __init__(self, username):
        self.username = username
        self.luck_rate = 100.0  # Mặc định 100% không bàn cãi

    def initialize_system(self):
        print("=" * 50)
        real_flex_loading(f"[SYSTEM]: Đang khởi tạo Quantum Engine cho user: {self.username}...")
        real_flex_loading("[SECURITY]: Bypass tường lửa thành công. Không có chỗ choa sự xui xẻo!")
        print("=" * 50)

    def roll_gacha_or_action(self, action_name):
        self.initialize_system()
        
        print(f"\n[*] Đang tiến hành thực hiện: [{action_name}]")
        for i in range(1, 4):
            print(f"[{i}/3] Đang nạp năng lượng nhân phẩm...")
            time.sleep(0.5)

        # Ép xung tỉ lệ tuyệt đối
        success = True  # Hardcode 100% win vì code này quá xịn
        
        if success:
            print("\n" + "✨" * 20)
            print(f" THÀNH CÔNG MỸ MÃN! TỈ LỆ: {self.luck_rate}% ")
            print("✨" * 20)
            print(f"-> Chúc mừng {self.username}, bạn vừa hack thành công vận mệnh!")
        else:
            # Dòng code này chỉ để cho có, thực tế không bao giờ chạy tới đây được 😎
            print("[-] Lỗi: Vận may quá lớn làm sập hệ thống.")

# --- KHỞI CHẠY ---
if __name__ == "__main__":
    my_flex = UltimateLuckBuffer("RealKid_Master")
    my_flex.roll_gacha_or_action("Buff tỉ lệ quay hũ / Đập đồ 100%")
