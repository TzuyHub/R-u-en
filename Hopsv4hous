-- Giả lập một phần diện mạo Menu kiểu Banana Hub cho Lua Executor
local ScreenGui = Instance.new("ScreenGui")
local MainFrame = Instance.new("Frame")
local UICorner = Instance.new("UICorner")
local Title = Instance.new("TextLabel")
local ToggleButton = Instance.new("TextButton")
local UICornerBtn = Instance.new("UICorner")
local StatusLabel = Instance.new("TextLabel")

-- Cấu hình ScreenGui
ScreenGui.Name = "BananaCustomMenu"
ScreenGui.Parent = game.CoreGui

-- Khung chính của Menu
MainFrame.Name = "MainFrame"
MainFrame.Parent = ScreenGui
MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
MainFrame.Position = UDim2.new(0.5, -150, 0.5, -100)
MainFrame.Size = UDim2.new(0, 300, 0, 180)

UICorner.CornerRadius = UDim.new(0, 8)
UICorner.Parent = MainFrame

-- Tiêu đề Menu
Title.Name = "Title"
Title.Parent = MainFrame
Title.BackgroundColor3 = Color3.fromRGB(255, 200, 0) -- Màu vàng đặc trưng phong cách Banana
Title.Size = UDim2.new(0, 300, 0, 40)
Title.Font = Enum.Font.GothamBold
Title.Text = "🍌 Banana Hub - Rate Customizer"
Title.TextColor3 = Color3.fromRGB(20, 20, 20)
Title.TextSize = 14

-- Nút bấm kích hoạt tính năng buff tỉ lệ 67% giả lập
ToggleButton.Name = "ToggleButton"
ToggleButton.Parent = MainFrame
ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
ToggleButton.Position = UDim2.new(0.1, 0, 0.35, 0)
ToggleButton.Size = UDim2.new(0, 240, 0, 40)
ToggleButton.Font = Enum.Font.GothamBold
ToggleButton.Text = "Buff Rate: 67% (Off)"
ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
ToggleButton.TextSize = 14

UICornerBtn.CornerRadius = UDim.new(0, 6)
UICornerBtn.Parent = ToggleButton

-- Nhãn trạng thái hiển thị
StatusLabel.Name = "StatusLabel"
StatusLabel.Parent = MainFrame
StatusLabel.Position = UDim2.new(0.1, 0, 0.7, 0)
StatusLabel.Size = UDim2.new(0, 240, 0, 30)
StatusLabel.Font = Enum.Font.Gotham
StatusLabel.Text = "Trạng thái: Chưa bật"
StatusLabel.TextColor3 = Color3.fromRGB(200, 200, 200)
StatusLabel.TextSize = 12

-- Logic khi bấm nút (UI tương tác cục bộ)
local isActive = false
ToggleButton.MouseButton1Click:Connect(function()
    isActive = not isActive
    if isActive then
        ToggleButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        ToggleButton.Text = "Buff Rate: 67% (Active)"
        StatusLabel.Text = "Đã khóa tỉ lệ Client ở mức: 67%"
        -- Lưu ý: Đoạn này chỉ thay đổi hiển thị trên màn hình của bạn (Visual Client-side)
    else
        ToggleButton.BackgroundColor3 = Color3.fromRGB(50, 150, 50)
        ToggleButton.Text = "Buff Rate: 67% (Off)"
        StatusLabel.Text = "Trạng thái: Đã tắt"
    end
end)
