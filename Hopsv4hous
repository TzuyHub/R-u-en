import time
import sys

def blox_typing(text, delay=0.015):
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(delay)
    print()

def clear_screen():
    print("\n" * 2)

class BloxFruitLuckHack:
    def __init__(self):
        self.beli = 999999999
        self.fragments = 500000

    def show_menu_banner(self):
        print("=" * 65)
        print(" 🏴‍☠️  BLOX FRUIT: QUANTUM LUCK SYSTEM (ADMIN BYPASS)  🏴‍☠️ ")
        print(f" 💰 Beli: {self.beli:,} | 💎 Fragments: {self.fragments:,}")
        print("=" * 65)

    def trigger_action(self, action_name, reward):
        clear_screen()
        print(f"[*] Đang thực hiện kết nối tới Server Blox Fruit...")
        blox_typing(f"[+] Đang bypass hệ thống Anti-Cheat cho: [{action_name}]...")
        time.sleep(0.5)
        blox_typing("[+] Ép xung RNG của Cousin (Gacha) và Blacksmith lên 100%...")
        time.sleep(0.5)
        
        print("\n" + "⚡" * 28)
        print(f" 🌟 ROLL THÀNH CÔNG: {reward.upper()} (TỈ LỆ: 100%) 🌟 ")
        print("⚡" * 28)
        blox_typing(f"-> Quá uy tín! Kho đồ của bạn vừa nhận được: [{reward}] vĩnh viễn!\n")

    def run(self):
        while True:
            self.show_menu_banner()
            print(" [1] 🍎 Roll Trái Ác Quỷ (Cousin) -> Chắc chắn ra Mythical (Kitsune/Leopard)")
            print(" [2] ⚔️ Cường hóa vũ khí / Thợ rèn (Cursed Dual Katana / Shark Anchor +Max)")
            print(" [3] 👑 Roll Tộc V4 / Thức tỉnh chủng tộc (Awakening Race Full Gear)")
            print(" [4] 🎯 Săn Sea Beast / Leviathan (100% rớt tim và nguyên liệu xịn)")
            print(" [0] 🚪 Thoát game (Đứng đảo giữa khoe item)")
            print("-" * 65)
            
            choice = input("👉 Click chọn tính năng buff [0-4]: ").strip()
            
            if choice == '1':
                self.trigger_action("Roll Trái Ác Quỷ", "Fruit: Kitsune-Kitsune (Permanent)")
            elif choice == '2':
                self.trigger_action("Nâng cấp Cursed Dual Katana", "CDK + Max Damage (Real Buff)")
            elif choice == '3':
                self.trigger_action("Quest Thức Tỉnh Tộc V4", "Full Gears & Ultimate Ability")
            elif choice == '4':
                self.trigger_action("Săn Leviathan", "Leviathan Heart & Scales x99")
            elif choice == '0':
                blox_typing("[-] Đang thoát game an toàn... Chúc bạn cày cuốc vui vẻ!")
                break
            else:
                print("⚠️ Phím bấm không hợp lệ, nhưng vì bạn là admin nên hệ thống vẫn châm chước!")
            
            input("Nhấn Enter để quay lại Menu chính...")
            clear_screen()

# --- KHỞI CHẠY ---
if __name__ == "__main__":
    game_hack = BloxFruitLuckHack()
    game_hack.run()
