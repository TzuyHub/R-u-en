import time
import sys

def typing_effect(text, delay=0.015):
    for char in text:
        sys.stdout.write(char)
        sys.stdout.flush()
        time.sleep(delay)
    print()

def clear_screen():
    print("\n" * 2)

class LuckControlPanel:
    def __init__(self):
        self.luck_rate = 100.0

    def show_banner(self):
        print("=" * 60)
        print(" 🔥  QUANTUM LUCK OVERRIDER - HỆ THỐNG BUFF 100% MAY MẮN  🔥 ")
        print("=" * 60)

    def trigger_buff(self, task_name):
        clear_screen()
        print(f"[*] Đang kích hoạt giao thức cho: [{task_name}]")
        typing_effect("[+] Đang bẻ cong thuật toán RNG của vũ trụ...")
        time.sleep(0.4)
        typing_effect("[+] Ép xung nhân phẩm lên ngưỡng tối đa (100.0%)...")
        time.sleep(0.4)
        
        print("\n" + "🌟" * 25)
        print(f" KẾT QUẢ: THÀNH CÔNG 100% TUYỆT ĐỐI! ")
        print("🌟" * 25)
        print(f"-> Chúc mừng! Bạn đã vượt qua mọi xác suất thống kê. Quá uy tín!\n")

    def run(self):
        while True:
            self.show_banner()
            print(" [1] 🗡️ Buff tỉ lệ đập đồ / Cường hóa (Không bao giờ xịt)")
            print(" [2] 🎰 Buff tỉ lệ quay Gacha / Random Item (Rate-up vô cực)")
            print(" [3] 🎲 Buff tỉ lệ xúc xắc / Thi cử / Trắc nghiệm (Đúng toàn tập)")
            print(" [4] 🚀 Kích hoạt siêu buff toàn diện (All-in)")
            print(" [0] ❌ Thoát (Vì vận may đã quá thừa thãi)")
            print("-" * 60)
            
            choice = input("👉 Nhấn chọn tính năng muốn buff [0-4]: ").strip()
            
            if choice == '1':
                self.trigger_buff("Cường hóa trang bị +15")
            elif choice == '2':
                self.trigger_buff("Quay Gacha banner giới hạn")
            elif choice == '3':
                self.trigger_buff("Khoanh bừa trắc nghiệm / Quay số")
            elif choice == '4':
                self.trigger_buff("Hệ thống tối thượng - Chấp mọi thể loại xác suất")
            elif choice == '0':
                typing_effect("[-] Đang ngắt kết nối... Chúc bạn luôn gặp may mắn trong đời thực!")
                break
            else:
                print("⚠️ Lựa chọn không hợp lệ, nhưng vì bạn là real kid nên vẫn được tính là may mắn!")
            
            input("Nhấn Enter để quay lại Menu chính...")
            clear_screen()

# --- KHỞI CHẠY CHƯƠNG TRÌNH ---
if __name__ == "__main__":
    panel = LuckControlPanel()
    panel.run()
